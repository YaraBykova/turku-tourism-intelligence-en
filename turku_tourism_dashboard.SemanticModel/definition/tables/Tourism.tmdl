	partition Tourism = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("127.0.0.1:5433", "turku_bi"),
				    marts_tourism_seasonality = Source{[Schema="marts",Item="tourism_seasonality"]}[Data]
				in
				    marts_tourism_seasonality

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
