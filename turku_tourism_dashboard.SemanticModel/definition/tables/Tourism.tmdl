table Tourism
	lineageTag: 544c7601-af12-417a-8118-1f117a380e5f

	measure 'Total Nights' = SUM(Tourism[hotel_nights])
		formatString: #,0
		displayFolder: Metrics
		lineageTag: be33c5c8-eb18-4d73-b521-07d7cbb371ca

	measure 'Domestic Nights' = SUM(Tourism[domestic_nights])
		formatString: #,0
		displayFolder: Metrics
		lineageTag: aaa693aa-1aa2-40f5-8dc9-e5d13bc5b816

	measure 'Foreign Nights' = SUM(Tourism[foreign_nights])
		formatString: #,0
		displayFolder: Metrics
		lineageTag: fa134bc1-5c97-4a7d-b701-a344b96ef762

	measure 'Foreign Share' = DIVIDE([Foreign Nights], [Total Nights])
		formatString: 0.00%
		displayFolder: Metrics
		lineageTag: 8fbd85e1-f46f-5470-9e1b-24ce8b016201

	measure 'Nights Previous Period' =
			VAR ChosenYear = SELECTEDVALUE(Tourism[year])
			VAR ObservedMonths = VALUES(Tourism[month_number])
			VAR Cities = VALUES(Tourism[municipality_code])
			VAR PriorRows =
			    CALCULATETABLE(
			        Tourism,
			        REMOVEFILTERS(Tourism),
			        TREATAS(Cities, Tourism[municipality_code]),
			        Tourism[year] = ChosenYear - 1,
			        TREATAS(ObservedMonths, Tourism[month_number])
			    )
			RETURN
			    IF(
			        NOT ISBLANK(ChosenYear)
			            && COUNTROWS(Tourism) > 0
			            && COUNTROWS(PriorRows) = COUNTROWS(ObservedMonths) * COUNTROWS(Cities),
			        SUMX(PriorRows, Tourism[hotel_nights])
			    )
		formatString: #,0
		displayFolder: Period comparison
		lineageTag: ac987db4-772d-5ee8-9ac1-32d0f5dc64bd

	measure 'Domestic Previous Period' =
			VAR ChosenYear = SELECTEDVALUE(Tourism[year])
			VAR ObservedMonths = VALUES(Tourism[month_number])
			VAR Cities = VALUES(Tourism[municipality_code])
			VAR PriorRows =
			    CALCULATETABLE(
			        Tourism,
			        REMOVEFILTERS(Tourism),
			        TREATAS(Cities, Tourism[municipality_code]),
			        Tourism[year] = ChosenYear - 1,
			        TREATAS(ObservedMonths, Tourism[month_number])
			    )
			RETURN
			    IF(
			        NOT ISBLANK(ChosenYear)
			            && COUNTROWS(Tourism) > 0
			            && COUNTROWS(PriorRows) = COUNTROWS(ObservedMonths) * COUNTROWS(Cities),
			        SUMX(PriorRows, Tourism[domestic_nights])
			    )
		formatString: #,0
		displayFolder: Period comparison
		lineageTag: 87cab7e3-e423-58f0-8ffa-974eebc2ef9d

	measure 'Foreign Previous Period' =
			VAR ChosenYear = SELECTEDVALUE(Tourism[year])
			VAR ObservedMonths = VALUES(Tourism[month_number])
			VAR Cities = VALUES(Tourism[municipality_code])
			VAR PriorRows =
			    CALCULATETABLE(
			        Tourism,
			        REMOVEFILTERS(Tourism),
			        TREATAS(Cities, Tourism[municipality_code]),
			        Tourism[year] = ChosenYear - 1,
			        TREATAS(ObservedMonths, Tourism[month_number])
			    )
			RETURN
			    IF(
			        NOT ISBLANK(ChosenYear)
			            && COUNTROWS(Tourism) > 0
			            && COUNTROWS(PriorRows) = COUNTROWS(ObservedMonths) * COUNTROWS(Cities),
			        SUMX(PriorRows, Tourism[foreign_nights])
			    )
		formatString: #,0
		displayFolder: Period comparison
		lineageTag: e1d17fc5-d62d-51f9-85d6-43e57560b8bd

	measure 'Nights Change' = IF(NOT ISBLANK([Nights Previous Period]), [Total Nights] - [Nights Previous Period])
		formatString: +#,0;-#,0;0
		displayFolder: Period comparison
		lineageTag: 99fe03f9-9aef-502a-a12a-c6becccf07ad

	measure 'Nights YoY' = IF(NOT ISBLANK([Nights Previous Period]), DIVIDE([Total Nights] - [Nights Previous Period], [Nights Previous Period]))
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Period comparison
		lineageTag: 2821142f-3f65-554a-b98d-c1fa2446236a

	measure 'Domestic YoY' = IF(NOT ISBLANK([Domestic Previous Period]), DIVIDE([Domestic Nights] - [Domestic Previous Period], [Domestic Previous Period]))
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Period comparison
		lineageTag: 2940d99f-f8e0-5887-8ff4-733f6ac8a1de

	measure 'Foreign YoY' = IF(NOT ISBLANK([Foreign Previous Period]), DIVIDE([Foreign Nights] - [Foreign Previous Period], [Foreign Previous Period]))
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Period comparison
		lineageTag: 06acda47-a2c4-5b70-abab-4b483a8e6e5b

	measure 'Foreign Share Change pp' =
			VAR PriorShare = DIVIDE([Foreign Previous Period], [Nights Previous Period])
			RETURN IF(NOT ISBLANK(PriorShare), ([Foreign Share] - PriorShare) * 100)
		formatString: +0.00 "pp";-0.00 "pp";0.00 "pp"
		displayFolder: Period comparison
		lineageTag: 8c1ed929-2995-516c-a3e5-2b0b2e14460e

	measure 'Selected Period' =
			VAR FirstMonth = MIN(Tourism[month])
			VAR LastMonth = MAX(Tourism[month])
			VAR MonthCount = DISTINCTCOUNT(Tourism[month])
			VAR IsPreliminary = COUNTROWS(FILTER(Tourism, Tourism[is_preliminary] = TRUE())) > 0
			RETURN
			    IF(
			        NOT HASONEVALUE(Tourism[year]),
			        "Select one year",
			        "Period: " & FORMAT(FirstMonth, "dd MMM yyyy")
			            & " — " & FORMAT(EOMONTH(LastMonth, 0), "dd MMM yyyy")
			            & "  |  Months: " & FORMAT(MonthCount, "0")
			            & IF(IsPreliminary, "  |  Preliminary data", "")
			    )
		displayFolder: Captions and source
		lineageTag: e251fae6-df7b-5094-b962-31b86301caf1

	measure 'Comparison Context' =
			VAR ChosenYear = SELECTEDVALUE(Tourism[year])
			VAR FirstMonth = MIN(Tourism[month_number])
			VAR LastMonth = MAX(Tourism[month_number])
			RETURN
			    IF(
			        ISBLANK([Nights Previous Period]),
			        "Prior-year comparison unavailable: the same months are not fully covered.",
			        "Comparison: " & FORMAT(DATE(ChosenYear - 1, FirstMonth, 1), "MM.yyyy")
			            & " — " & FORMAT(DATE(ChosenYear - 1, LastMonth, 1), "MM.yyyy")
			            & ": same calendar months only. Change: "
			            & FORMAT([Nights Change], "+#,0;-#,0;0") & " hotel nights."
			    )
		displayFolder: Captions and source
		lineageTag: b5b3da1d-2984-571c-bd36-8defaf4ad6d4

	measure 'Data Status' =
			VAR LatestMonth = CALCULATE(MAX(Tourism[month]), REMOVEFILTERS(Tourism))
			VAR Retrieved = CALCULATE(MAX(Tourism[retrieved_at_utc]), REMOVEFILTERS(Tourism))
			RETURN
			    "StatFin 11lm  |  Data through " & FORMAT(LatestMonth, "MM.yyyy")
			        & "  |  Retrieved: " & FORMAT(Retrieved, "dd MMM yyyy")
			        & "  |  Power BI import: use Refresh"
		displayFolder: Captions and source
		lineageTag: 924afb5d-bd17-5867-a021-a4d7725a862a

	measure 'Domestic Month Share' =
			VAR YearMonths = CALCULATE(DISTINCTCOUNT(Tourism[month]), ALLEXCEPT(Tourism, Tourism[year], Tourism[municipality_code]))
			VAR YearTotal = CALCULATE([Domestic Nights], ALLEXCEPT(Tourism, Tourism[year], Tourism[municipality_code]))
			RETURN IF(HASONEVALUE(Tourism[year]) && YearMonths = 12, DIVIDE([Domestic Nights], YearTotal))
		formatString: 0.00%
		displayFolder: Seasonality
		lineageTag: 238c9054-1018-5013-ac32-323acccd912d

	measure 'Domestic Summer Share' =
			VAR YearMonths = CALCULATE(DISTINCTCOUNT(Tourism[month]), ALLEXCEPT(Tourism, Tourism[year], Tourism[municipality_code]))
			VAR SummerTotal = CALCULATE([Domestic Nights], Tourism[month_number] IN {6, 7, 8})
			RETURN IF(HASONEVALUE(Tourism[year]) && YearMonths = 12, DIVIDE(SummerTotal, [Domestic Nights]))
		formatString: 0.00%
		displayFolder: Seasonality
		lineageTag: b33b243a-4b97-5da7-b34e-116904d78a04

	measure 'Foreign Month Share' =
			VAR YearMonths = CALCULATE(DISTINCTCOUNT(Tourism[month]), ALLEXCEPT(Tourism, Tourism[year], Tourism[municipality_code]))
			VAR YearTotal = CALCULATE([Foreign Nights], ALLEXCEPT(Tourism, Tourism[year], Tourism[municipality_code]))
			RETURN IF(HASONEVALUE(Tourism[year]) && YearMonths = 12, DIVIDE([Foreign Nights], YearTotal))
		formatString: 0.00%
		displayFolder: Seasonality
		lineageTag: 6e0c9b8e-f807-5608-9d80-a63814ba919b

	measure 'Foreign Summer Share' =
			VAR YearMonths = CALCULATE(DISTINCTCOUNT(Tourism[month]), ALLEXCEPT(Tourism, Tourism[year], Tourism[municipality_code]))
			VAR SummerTotal = CALCULATE([Foreign Nights], Tourism[month_number] IN {6, 7, 8})
			RETURN IF(HASONEVALUE(Tourism[year]) && YearMonths = 12, DIVIDE(SummerTotal, [Foreign Nights]))
		formatString: 0.00%
		displayFolder: Seasonality
		lineageTag: 32cdce59-835d-52e4-b7dc-4d5f1a5db5fc

	measure 'Peak Month' =
			VAR MonthlyTotals = SUMMARIZE(Tourism, Tourism[month_number], "Nights", [Total Nights])
			VAR Peak = TOPN(1, MonthlyTotals, [Nights], DESC, Tourism[month_number], ASC)
			VAR PeakNumber = MAXX(Peak, Tourism[month_number])
			RETURN IF(HASONEVALUE(Tourism[year]), SWITCH(PeakNumber, 1, "January", 2, "February", 3, "March", 4, "April", 5, "May", 6, "June", 7, "July", 8, "August", 9, "September", 10, "October", 11, "November", 12, "December"))
		displayFolder: Seasonality
		lineageTag: 90e9868d-35d9-5422-9935-5a4526b86604

	measure 'Turku YoY' = CALCULATE([Nights YoY], REMOVEFILTERS(Tourism[City]), Tourism[municipality_code] = "853")
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: City comparison
		lineageTag: c2626bc7-7910-567a-8d5a-bdbde2a81ff1

	measure 'Tampere YoY' = CALCULATE([Nights YoY], REMOVEFILTERS(Tourism[City]), Tourism[municipality_code] = "837")
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: City comparison
		lineageTag: e9e841e0-96ef-55d2-8114-bd8939e3585d

	measure 'Oulu YoY' = CALCULATE([Nights YoY], REMOVEFILTERS(Tourism[City]), Tourism[municipality_code] = "564")
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: City comparison
		lineageTag: 0635de3b-3518-5b17-b88f-14c4b2dfc6ec

	measure 'Domestic Contribution pp' =
			IF(NOT ISBLANK([Domestic Previous Period]),
			    100 * DIVIDE([Domestic Nights] - [Domestic Previous Period], [Nights Previous Period]))
		formatString: +0.00 "pp";-0.00 "pp";0.00 "pp"
		displayFolder: City comparison
		lineageTag: a8a9c094-d707-5751-9b3e-534ac4a9e27b

	measure 'Foreign Contribution pp' =
			IF(NOT ISBLANK([Foreign Previous Period]),
			    100 * DIVIDE([Foreign Nights] - [Foreign Previous Period], [Nights Previous Period]))
		formatString: +0.00 "pp";-0.00 "pp";0.00 "pp"
		displayFolder: City comparison
		lineageTag: d8319021-7553-5ca0-bbdd-64d0b24acf30

	measure 'Profile Year' =
			VAR Chosen = SELECTEDVALUE(Tourism[year])
			VAR ThisRows = CALCULATE(COUNTROWS(Tourism), REMOVEFILTERS(Tourism), Tourism[year] = Chosen)
			VAR PriorRows = CALCULATE(COUNTROWS(Tourism), REMOVEFILTERS(Tourism), Tourism[year] = Chosen - 1)
			RETURN IF(NOT ISBLANK(Chosen), IF(ThisRows = 36, Chosen, IF(PriorRows = 36, Chosen - 1)))
		formatString: 0
		displayFolder: City comparison
		lineageTag: 7ddbd60f-8781-5155-ac08-55d8d2f34e17

	measure 'Profile Context' =
			VAR Y = [Profile Year]
			RETURN IF(ISBLANK(Y), "No complete year available for seasonality",
			    "Seasonality: " & FORMAT(Y, "0") & ". Monthly share of each city’s annual hotel nights (12 months)."
			    & IF(Y <> SELECTEDVALUE(Tourism[year]), " Selected year is incomplete.", ""))
		displayFolder: City comparison
		lineageTag: 047b23d0-2b82-53c9-b66b-5409991a6d7f

	measure 'Turku Annual Profile' =
			VAR Y = [Profile Year]
			VAR Months = VALUES('Profile Months'[Month Number])
			VAR Numerator = CALCULATE([Total Nights], REMOVEFILTERS(Tourism),
			    Tourism[municipality_code] = "853", Tourism[year] = Y, TREATAS(Months, Tourism[month_number]))
			VAR Denominator = CALCULATE([Total Nights], REMOVEFILTERS(Tourism),
			    Tourism[municipality_code] = "853", Tourism[year] = Y)
			RETURN IF(NOT ISBLANK(Y), DIVIDE(Numerator, Denominator))
		formatString: 0.00%
		displayFolder: City comparison
		lineageTag: 0175566a-b15c-5875-95ab-b78ec5876dea

	measure 'Tampere Annual Profile' =
			VAR Y = [Profile Year]
			VAR Months = VALUES('Profile Months'[Month Number])
			VAR Numerator = CALCULATE([Total Nights], REMOVEFILTERS(Tourism),
			    Tourism[municipality_code] = "837", Tourism[year] = Y, TREATAS(Months, Tourism[month_number]))
			VAR Denominator = CALCULATE([Total Nights], REMOVEFILTERS(Tourism),
			    Tourism[municipality_code] = "837", Tourism[year] = Y)
			RETURN IF(NOT ISBLANK(Y), DIVIDE(Numerator, Denominator))
		formatString: 0.00%
		displayFolder: City comparison
		lineageTag: 036872f6-0506-538a-b329-cfe0ab7bceae

	measure 'Oulu Annual Profile' =
			VAR Y = [Profile Year]
			VAR Months = VALUES('Profile Months'[Month Number])
			VAR Numerator = CALCULATE([Total Nights], REMOVEFILTERS(Tourism),
			    Tourism[municipality_code] = "564", Tourism[year] = Y, TREATAS(Months, Tourism[month_number]))
			VAR Denominator = CALCULATE([Total Nights], REMOVEFILTERS(Tourism),
			    Tourism[municipality_code] = "564", Tourism[year] = Y)
			RETURN IF(NOT ISBLANK(Y), DIVIDE(Numerator, Denominator))
		formatString: 0.00%
		displayFolder: City comparison
		lineageTag: 353fe263-64fa-54c0-86da-19571cb06780

	measure 'City Period' =
			VAR Chosen = SELECTEDVALUE(Tourism[year])
			VAR FirstMonth = MIN(Tourism[month])
			VAR LastMonth = MAX(Tourism[month])
			RETURN IF(NOT ISBLANK(Chosen), FORMAT(FirstMonth, "MM.yyyy") & " — " & FORMAT(LastMonth, "MM.yyyy")
			    & " versus the same months of " & FORMAT(Chosen - 1, "0")
			    & IF(Chosen = 2019, ": no 2018 baseline", "")
			    & IF(COUNTROWS(FILTER(Tourism, Tourism[is_preliminary] = TRUE())) > 0, " | Preliminary data", ""))
		displayFolder: City comparison
		lineageTag: 1a2e545c-ac4b-5c54-a201-f88a6c515ac0

